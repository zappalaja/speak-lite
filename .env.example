# Copy to .env and fill in. NEVER commit .env.

# --- required: data access ---------------------------------------------
# ArrayLake token for GFDL/noaa-gfdl-spear-large-ensembles-pds
# (alternative: run `arraylake auth login` and leave this unset)
ARRAYLAKE_TOKEN=

# --- SPEAK chat (optional — chat is disabled without a key) ------------
GEMINI_API_KEY=
# fallback if Gemini is rate-limited / unavailable
ANTHROPIC_API_KEY=
# default model; falls back through newer->older Gemini, then Claude
#VIEWER_CHAT_MODEL=gemini-flash-latest

# --- server ------------------------------------------------------------
#VIEWER_HOST=127.0.0.1        # 0.0.0.0 in containers / cloud
#VIEWER_PORT=8601
#RAG_API_URL=http://localhost:8002

# --- disk cache (shared across users, LRU-bounded) ---------------------
#VIEWER_DISK_CACHE=1          # 0 = fully stateless (no local cache)
#VIEWER_CACHE_MAX_GB=10

# --- chat rate limits (per requester IP unless noted) ------------------
#CHAT_MIN_INTERVAL_SECS=4
#CHAT_PER_MINUTE=8
#CHAT_PER_DAY_IP=150
#CHAT_PER_DAY_GLOBAL=2000
#CHAT_MAX_CHARS=4000
